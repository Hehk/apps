{
  "name": "inoread-apps",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @inoread/starter --filter @inoread/api dev",
    "build": "pnpm --filter @inoread/starter build && pnpm --filter @inoread/api check",
    "typecheck": "pnpm --filter @inoread/starter typecheck && pnpm --filter @inoread/api check",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "packageManager": "pnpm@12.4.2"
}
